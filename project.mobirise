          "_name": "aheader5",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header5 expertm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/chatgpt-image-30-abr-2025-22-00-52.png-1536x1024.png\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#212428\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background7.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                    UN MANCO PROFECIONAL</h1>\n                <h1 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\"><b>UN MANCO PROFECIONAL XD</b></h1>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Rhoncus dolor purus non enim praesent elementum facilisis. Faucibus turpis in eu mi bibendum neque\n                    amet purus gravida quis.\n                </p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        CONTACT ME\n                    </a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "thXW3OwmyZ",
          "_anchor": "aheader5-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "background-attachment": "fixed",
              "background-repeat": "no-repeat",
              "background-size": "cover",
              "background-position": "center center"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".container": {
              "padding-left": "15px",
              "padding-right": "15px",
              "@media (max-width: 1199px)": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".row": {
              "margin-left": "-25px",
              "margin-right": "-25px",
              "justify-content": "flex-start",
              "> [class*=\"col\"]": {
                "padding-left": "25px",
                "padding-right": "25px"
              },
              "@media (max-width: 1199px)": {
                "margin-left": "-15px",
                "margin-right": "-15px",
                "> [class*=\"col\"]": {
                  "padding-left": "15px",
                  "padding-right": "15px"
                }
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "20px"
            },
            ".mbr-section-title": {
              "color": "#ffe900",
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "margin-top": "15px",
              "@media (max-width: 767px)": {
                "margin-top": "10px",
                "text-align": "center"
              }
            },
            ".card-row": {
              "align-items": "stretch"
            },
            ".item": {
              "margin-top": "30px"
            },
            ".item-wrapper": {
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "padding": "30px 30px 34px",
              "border-radius": "20px",
              "overflow": "hidden",
              "background": "linear-gradient(145deg, @cardBg1, @cardBg2)",
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              },
              "@media (max-width: 575px)": {
                "padding": "20px 20px 24px"
              },
              "&:hover": {
                ".card-bg": {
                  "opacity": "1"
                },
                ".item-img": {
                  "img": {
                    "transform": "scale(1.1)"
                  }
                }
              }
            },
            ".card-bg": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "z-index": "0",
              "width": "100%",
              "height": "100%",
              "border-radius": "19px",
              "background": "linear-gradient(to right bottom, @cardHoverBg1, @cardHoverBg2)",
              "opacity": "0",
              "transition": ".4s all"
            },
            ".item-img": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "100%",
              "border-radius": "10px",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "aspect-ratio": "(34 / 25)",
                "object-fit": "cover",
                "transition": "0.4s all"
              }
            },
            ".card-box": {
              "position": "relative",
              "z-index": "5",
              "padding-top": "25px"
            },
            ".head-container": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "margin-bottom": "15px",
              "@media (max-width: 767px)": {
                "margin-bottom": "10px"
              }
            },
            ".card-title": {
              "position": "relative",
              "z-index": "5",
              "color": "#ffe900",
              "margin-bottom": "0",
              "flex-basis": "60%",
              "margin-right": "auto"
            },
            ".comment-item": {
              "display": "flex",
              "justify-content": "flex-end",
              "align-items": "center",
              "flex-basis": "40%",
              "margin-left": "auto"
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "flex-start",
              "margin-right": "4px",
              ".mbr-iconfont": {
                "font-size": "16px",
                "color": "@iconColor"
              }
            },
            ".comment-item-text": {
              "color": "#C4CFDE"
            },
            ".card-text": {
              "position": "relative",
              "z-index": "5",
              "color": "#C4CFDE",
              "margin-bottom": "0",
              "a": {
                "transition": ".4s all",
                "&:hover": {
                  "color": "@primaryColor !important"
                }
              }
            }
          },
          "_name": "agallery4",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery4 expertm5\" group=\"Gallery &amp; Slider\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected=\"\">Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked=\"\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked=\"\">\n        <input type=\"checkbox\" title=\"Comment\" name=\"showComment\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" condition=\"showComment\" checked=\"\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffe900\" condition=\"showIcon &amp;&amp; showComment\">\n        <header>Card Style</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked=\"\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow\">\n        <header>Card Hover</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardHoverBg1\" value=\"#212428\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardHoverBg2\" value=\"#16181c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#212428\" selected=\"\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">Fotos etc etc</h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\"><b>Trabajos etc</b></h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"item features-image col-12 col-md-6 col-xl-4 active\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"item-img\">\n                        <a href=\"#\" onclick=\"abrirGaleria(); return false;\">\n          <img src=\"@PROJECT_PATH@/assets/images/mbr-673x379.jpg\" class=\"img-fluid rounded shadow\" alt=\"Imagen miniatura\">\n        </a>\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showComment\">\n                        <div class=\"head-container\" mbr-if=\"showTitle|| showComment\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                EJEMPLO 1</h5>\n                            <div class=\"comment-item\" mbr-if=\"showComment\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-clock mobi-mbri\"></span>\n                                </div>\n                                <p class=\"comment-item-text mbr-fonts-style mb-0\" data-app-selector=\".comment-item-text\" mbr-theme-style=\"display-7\">\n                                    4 min read\n                                </p>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">dsfsdfsdfsdfsdfsdfsd</p>\n                    </div>\n                </div>\n            </div><div class=\"item features-image col-12 col-md-6 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"item-img\">\n                        <a href=\"#\" onclick=\"abrirGaleria(); return false;\">\n          <img src=\"@PROJECT_PATH@/assets/images/pexels-victor-freitas-841130-1920x1280.jpg\" class=\"img-fluid rounded shadow\" alt=\"Imagen miniatura\" data-slide-to=\"2\" data-bs-slide-to=\"3\">\n        </a>\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText || showComment\">\n                        <div class=\"head-container\" mbr-if=\"showTitle|| showComment\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                EJEMPLO 1</h5>\n                            <div class=\"comment-item\" mbr-if=\"showComment\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-clock mobi-mbri\"></span>\n                                </div>\n                                <p class=\"comment-item-text mbr-fonts-style mb-0\" data-app-selector=\".comment-item-text\" mbr-theme-style=\"display-7\">\n                                    4 min read\n                                </p>\n                            </div>\n                        </div>\n                        <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">dsfsdfsdfsdfsdfsdfsd</p>\n                    </div>