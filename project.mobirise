            "<script>\n    function abrirGaleria() {\n      var modal = new bootstrap.Modal(document.getElementById('galeriaModal'));\n      modal.show();\n    }\n  </script>",
            "<script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js\"></script>"
